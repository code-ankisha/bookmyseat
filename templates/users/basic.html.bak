<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% block title %}BookMySeat{% endblock %}</title>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"/>
  <style>
    :root {
      --red: #e63946;
      --dark: #0d0d0d;
      --dark2: #1a1a2e;
      --card-bg: #16213e;
      --accent: #f4a261;
      --text-light: #e0e0e0;
      --text-muted: #9e9e9e;
      --success: #2a9d8f;
      --navbar-h: 64px;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Poppins', sans-serif;
      background: var(--dark);
      color: var(--text-light);
      min-height: 100vh;
    }
    /* NAVBAR */
    .navbar {
      background: rgba(13,13,13,0.97) !important;
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(230,57,70,0.2);
      height: var(--navbar-h);
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .navbar-brand {
      font-family: 'Nunito', sans-serif;
      font-weight: 900;
      font-size: 1.5rem;
      color: #fff !important;
      letter-spacing: -0.5px;
    }
    .navbar-brand span { color: var(--red); }
    .navbar-brand .dot { color: var(--accent); }
    .nav-link {
      color: var(--text-light) !important;
      font-weight: 500;
      font-size: 0.9rem;
      padding: 0.4rem 0.9rem !important;
      border-radius: 6px;
      transition: all 0.2s;
    }
    .nav-link:hover { color: #fff !important; background: rgba(230,57,70,0.15); }
    .btn-nav-primary {
      background: var(--red);
      color: #fff !important;
      border-radius: 8px;
      font-weight: 600;
      padding: 0.4rem 1.1rem !important;
      transition: all 0.2s;
    }
    .btn-nav-primary:hover { background: #c1121f; transform: translateY(-1px); }
    .navbar-toggler { border-color: rgba(230,57,70,0.4); }
    .navbar-toggler-icon { filter: invert(1); }

    /* MESSAGES */
    .messages-container { position: fixed; top: 74px; right: 16px; z-index: 9999; min-width: 300px; }
    .alert { border-radius: 10px; border: none; font-size: 0.875rem; font-weight: 500; box-shadow: 0 4px 20px rgba(0,0,0,0.4); }
    .alert-success { background: #1a3a2a; color: #5ce65c; border-left: 3px solid #2a9d8f; }
    .alert-danger  { background: #3a1a1a; color: #ff6b6b; border-left: 3px solid var(--red); }
    .alert-warning { background: #3a2e1a; color: #ffd166; border-left: 3px solid var(--accent); }
    .alert-info    { background: #1a2a3a; color: #74b9ff; border-left: 3px solid #0984e3; }

    /* MAIN CONTENT */
    .main-content { min-height: calc(100vh - var(--navbar-h) - 200px); }

    /* CARDS */
    .movie-card {
      background: var(--card-bg);
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.06);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      cursor: pointer;
    }
    .movie-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 16px 40px rgba(230,57,70,0.2);
      border-color: rgba(230,57,70,0.3);
    }
    .movie-card img { width: 100%; height: 280px; object-fit: cover; }
    .movie-card .card-body { padding: 14px; }
    .movie-card .card-title {
      font-family: 'Nunito', sans-serif;
      font-weight: 700;
      font-size: 1rem;
      color: #fff;
      margin-bottom: 6px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .rating-badge {
      background: rgba(244,162,97,0.15);
      color: var(--accent);
      border: 1px solid rgba(244,162,97,0.3);
      border-radius: 20px;
      padding: 2px 10px;
      font-size: 0.78rem;
      font-weight: 600;
    }
    .genre-badge {
      background: rgba(230,57,70,0.12);
      color: #ff8fa3;
      border: 1px solid rgba(230,57,70,0.2);
      border-radius: 20px;
      padding: 2px 10px;
      font-size: 0.75rem;
      font-weight: 500;
    }

    /* BUTTONS */
    .btn-primary {
      background: var(--red) !important;
      border: none !important;
      border-radius: 8px;
      font-weight: 600;
      transition: all 0.2s;
    }
    .btn-primary:hover { background: #c1121f !important; transform: translateY(-1px); }
    .btn-outline-primary {
      color: var(--red) !important;
      border-color: var(--red) !important;
      border-radius: 8px;
      font-weight: 600;
    }
    .btn-outline-primary:hover { background: var(--red) !important; color: #fff !important; }
    .btn-success { background: var(--success) !important; border: none !important; border-radius: 8px; font-weight: 600; }

    /* FORMS */
    .form-control, .form-select {
      background: rgba(255,255,255,0.05) !important;
      border: 1px solid rgba(255,255,255,0.1) !important;
      color: #fff !important;
      border-radius: 8px;
    }
    .form-control:focus, .form-select:focus {
      background: rgba(255,255,255,0.08) !important;
      border-color: var(--red) !important;
      box-shadow: 0 0 0 3px rgba(230,57,70,0.15) !important;
      color: #fff !important;
    }
    .form-control::placeholder { color: var(--text-muted) !important; }
    .form-label { color: var(--text-light); font-weight: 500; font-size: 0.875rem; }
    .input-group-text {
      background: rgba(230,57,70,0.1) !important;
      border: 1px solid rgba(255,255,255,0.1) !important;
      color: var(--red) !important;
    }

    /* AUTH CARDS */
    .auth-card {
      background: var(--card-bg);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 16px;
      overflow: hidden;
    }
    .auth-card .card-header {
      background: linear-gradient(135deg, var(--red), #c1121f) !important;
      border: none;
      padding: 1.25rem 1.5rem;
    }
    .auth-card .card-footer {
      background: rgba(255,255,255,0.03) !important;
      border-top: 1px solid rgba(255,255,255,0.06) !important;
      color: var(--text-muted);
    }
    .auth-card .card-footer a { color: var(--accent); text-decoration: none; font-weight: 600; }
    .auth-card .card-footer a:hover { color: #fff; }

    /* SECTION TITLES */
    .section-title {
      font-family: 'Nunito', sans-serif;
      font-size: 1.4rem;
      font-weight: 800;
      color: #fff;
      margin: 2rem 0 1.2rem;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .section-title::after {
      content: '';
      flex: 1;
      height: 2px;
      background: linear-gradient(90deg, rgba(230,57,70,0.5), transparent);
      border-radius: 2px;
    }
    .section-title .title-icon { color: var(--red); }

    /* FOOTER */
    .footer {
      background: #0a0a0a;
      border-top: 1px solid rgba(255,255,255,0.06);
      padding: 2.5rem 0 1.5rem;
      margin-top: 4rem;
      color: var(--text-muted);
    }
    .footer h5 { color: #fff; font-weight: 700; margin-bottom: 1rem; font-family: 'Nunito', sans-serif; }
    .footer a { color: var(--text-muted); text-decoration: none; transition: color 0.2s; font-size: 0.875rem; }
    .footer a:hover { color: var(--red); }
    .footer .social-icons a {
      display: inline-flex; align-items: center; justify-content: center;
      width: 36px; height: 36px; border-radius: 8px;
      background: rgba(255,255,255,0.06);
      color: var(--text-light) !important;
      margin-right: 8px;
      transition: all 0.2s;
    }
    .footer .social-icons a:hover { background: var(--red); color: #fff !important; transform: translateY(-2px); }
    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.05); margin-top: 1.5rem; padding-top: 1rem; }
    .footer-logo { font-family: 'Nunito', sans-serif; font-weight: 900; font-size: 1.3rem; color: #fff; }
    .footer-logo span { color: var(--red); }

    /* SCROLLBAR */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--dark); }
    ::-webkit-scrollbar-thumb { background: var(--red); border-radius: 3px; }

    /* CAROUSEL */
    .carousel-item img { height: 380px; object-fit: cover; border-radius: 0; }
    .carousel-overlay {
      position: absolute; bottom: 0; left: 0; right: 0;
      background: linear-gradient(transparent, rgba(0,0,0,0.85));
      padding: 2rem;
    }

    /* RESPONSIVE */
    @media (max-width: 768px) {
      .movie-card img { height: 220px; }
      .carousel-item img { height: 200px; }
      .section-title { font-size: 1.1rem; }
    }
  </style>
  {% block extra_css %}{% endblock %}
</head>
<body>
  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg">
    <div class="container">
      <a class="navbar-brand" href="/">
        <i class="fas fa-film me-2" style="color:var(--red)"></i>Book<span>My</span>Seat<span class="dot">.</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav me-auto ms-3">
          <li class="nav-item"><a class="nav-link" href="/"><i class="fas fa-home me-1"></i>Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/movies/"><i class="fas fa-clapperboard me-1"></i>Movies</a></li>
        </ul>
        <ul class="navbar-nav ms-auto align-items-center gap-2">
          {% if user.is_authenticated %}
            <li class="nav-item">
              <a class="nav-link" href="{% url 'profile' %}">
                <i class="fas fa-circle-user me-1" style="color:var(--accent)"></i>{{ user.username }}
              </a>
            </li>
            <li class="nav-item">
              <form method="POST" action="{% url 'logout' %}" class="d-inline">
                {% csrf_token %}
                <button type="submit" class="btn btn-sm btn-outline-danger rounded-3 px-3">
                  <i class="fas fa-right-from-bracket me-1"></i>Logout
                </button>
              </form>
            </li>
          {% else %}
            <li class="nav-item"><a class="nav-link" href="{% url 'login' %}">Login</a></li>
            <li class="nav-item"><a class="nav-link btn-nav-primary" href="{% url 'register' %}">Register</a></li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>

  <!-- FLASH MESSAGES -->
  {% if messages %}
  <div class="messages-container">
    {% for message in messages %}
    <div class="alert alert-{{ message.tags }} alert-dismissible fade show" role="alert">
      {{ message }}
      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <!-- MAIN CONTENT -->
  <div class="main-content">
    {% block content %}{% endblock %}
  </div>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container">
      <div class="row">
        <div class="col-md-4 mb-4 mb-md-0">
          <div class="footer-logo mb-2"><i class="fas fa-film me-2" style="color:var(--red)"></i>Book<span>My</span>Seat</div>
          <p style="font-size:0.85rem;">Your ultimate destination for booking movie tickets online. Fast, easy, and reliable.</p>
        </div>
        <div class="col-md-2 mb-4 mb-md-0">
          <h5>Navigate</h5>
          <ul class="list-unstyled" style="line-height:2">
            <li><a href="/">Home</a></li>
            <li><a href="/movies/">Movies</a></li>
            {% if user.is_authenticated %}
            <li><a href="{% url 'profile' %}">My Profile</a></li>
            {% else %}
            <li><a href="{% url 'login' %}">Login</a></li>
            {% endif %}
          </ul>
        </div>
        <div class="col-md-3 mb-4 mb-md-0">
          <h5>Support</h5>
          <ul class="list-unstyled" style="line-height:2">
            <li><a href="#">Help Center</a></li>
            <li><a href="#">Cancellation Policy</a></li>
            <li><a href="#">Contact Us</a></li>
            <li><a href="#">Privacy Policy</a></li>
          </ul>
        </div>
        <div class="col-md-3">
          <h5>Follow Us</h5>
          <div class="social-icons mt-2">
            <a href="#"><i class="fab fa-facebook-f"></i></a>
            <a href="#"><i class="fab fa-twitter"></i></a>
            <a href="#"><i class="fab fa-instagram"></i></a>
            <a href="#"><i class="fab fa-youtube"></i></a>
          </div>
          <p class="mt-3" style="font-size:0.8rem;">Download our App</p>
          <div class="d-flex gap-2 flex-wrap">
            <a href="#" class="btn btn-sm" style="background:rgba(255,255,255,0.08);color:#fff;border-radius:8px;font-size:0.75rem;">
              <i class="fab fa-apple me-1"></i>App Store
            </a>
            <a href="#" class="btn btn-sm" style="background:rgba(255,255,255,0.08);color:#fff;border-radius:8px;font-size:0.75rem;">
              <i class="fab fa-google-play me-1"></i>Play Store
            </a>
          </div>
        </div>
      </div>
      <div class="footer-bottom text-center">
        <p style="font-size:0.8rem;" class="mb-0">&copy; 2024 BookMySeat. All rights reserved. | Made with <i class="fas fa-heart" style="color:var(--red)"></i> for movie lovers</p>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Auto-dismiss messages after 4 seconds -->
  <script>
    setTimeout(() => {
      document.querySelectorAll('.messages-container .alert').forEach(el => {
        let bsAlert = bootstrap.Alert.getOrCreateInstance(el);
        bsAlert.close();
      });
    }, 4000);
  </script>
  {% block extra_js %}{% endblock %}
</body>
</html>
